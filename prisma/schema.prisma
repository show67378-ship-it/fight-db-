// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Gym {
  id           String   @id
  name         String
  nameKana     String?
  sports       String[]
  // 複数競技を教えるジムの主要ジャンル(表示順の並び替えに使用)
  primarySport String?
  // 全体順位: 競技を問わず最優先で並べたい場合の手動指定
  priorityRank Int?
  // ジャンル内順位の手動調整(小さいほど先に表示)
  displayOrder Int?
  // 名門度(自動算出): 所属選手数・実績等から算出。高いほど上位表示
  prestigeScore Float?
  prefecture   String
  city         String
  address      String?
  phone        String?
  contactEmail String?
  trialInfo    String
  photo        String
  planTier     String   @default("free")
  description  String
  instructors  Json?
  websiteUrl   String?
  featured     Boolean  @default(false)
  // 管理者が内容を確認済みのジムはクロールによる自動上書きの対象外にする
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Athlete {
  id            String   @id
  name          String
  nameKana      String
  sport         String
  organizations String[]
  photo         String
  birthdate     String?
  heightCm      Float?
  weightKg      Float?
  reachCm       Float?
  weightClass   String
  nationality   String
  gymId         String?
  gymNote       String?
  // 全体順位の手動調整(小さいほど先に表示)
  displayOrder  Int?
  // 所属団体(表示順の並び替えに使用)。取得元から自動判定、または手動設定
  primaryOrganization String?
  // 活躍度(自動算出): 戦績・注目選手指定等から算出。高いほど上位表示
  prominenceScore Float?
  bio           String?
  nickname      String?
  signatureMove String?
  fightingStyle String?
  stance        String?
  backbone      String?
  sns           Json     @default("[]")
  record        Json?
  recordNote    String?
  sourceUrl     String?
  featured      Boolean  @default(false)
  // 管理者が内容を確認済みの選手はクロールによる自動上書きの対象外にする(戦績・戦績補足は除く)
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Match {
  id             String   @id
  sport          String
  organization   String
  eventName      String
  eventDate      String
  venue          String
  athleteAId     String
  athleteBId     String
  status         String
  votesA         Int      @default(0)
  votesB         Int      @default(0)
  resultWinnerId String?
  sourceUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DreamMatchCard {
  id         String @id
  sport      String
  organization String
  athleteAId String
  athleteBId String
  votes      Int    @default(0)
}

model TrialApplication {
  id            String   @id
  gymId         String
  name          String
  phone         String?
  email         String?
  preferredDate String?
  message       String?
  status        String   @default("new")
  createdAt     DateTime @default(now())
}

model EditRequest {
  id            String   @id
  targetType    String
  targetId      String
  targetName    String
  content       String
  contactName   String?
  contactEmail  String?
  status        String   @default("new")
  createdAt     DateTime @default(now())
}

model GymListingRequest {
  id            String   @id
  gymName       String
  sports        String[]
  prefecture    String
  city          String
  address       String?
  phone         String?
  websiteUrl    String?
  description   String?
  contactName   String
  contactEmail  String
  status        String   @default("new")
  createdAt     DateTime @default(now())
}
