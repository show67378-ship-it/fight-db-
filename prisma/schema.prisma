// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Gym {
  id           String   @id
  name         String
  nameKana     String?
  sports       String[]
  // 複数競技を教えるジムの主要ジャンル(表示順の並び替えに使用)
  primarySport String?
  // 全体順位: 競技を問わず最優先で並べたい場合の手動指定
  priorityRank Int?
  // ジャンル内順位の手動調整(小さいほど先に表示)
  displayOrder Int?
  // 名門度(自動算出): 所属選手数・実績等から算出。高いほど上位表示
  prestigeScore Float?
  prefecture   String
  city         String
  address      String?
  phone        String?
  contactEmail String?
  trialInfo    String
  photo        String
  planTier     String   @default("free")
  description  String
  instructors  Json?
  websiteUrl   String?
  featured     Boolean  @default(false)
  // 管理者が内容を確認済みのジムはクロールによる自動上書きの対象外にする
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // --- 全国フルクロール機能で追加(既存フィールドはそのまま維持) ---
  normalizedName   String?
  nameEn           String?
  aliases          String[] @default([])
  postalCode       String?
  latitude         Float?
  longitude        Float?
  instagram        String?
  xUrl             String?
  youtube          String?
  facebook         String?
  representative   String?
  headCoach        String?
  businessHours    String?
  trialAvailable   Boolean?
  trialPrice       Int?
  admissionFee     Int?
  monthlyFeeMin    Int?
  monthlyFeeMax    Int?
  kidsClass        Boolean?
  womenClass       Boolean?
  beginnerFriendly Boolean?
  active           Boolean  @default(true)
  googlePlaceId    String?  @unique
  lastVerifiedAt   DateTime?

  disciplines  GymDiscipline[]
  fighterGyms  FighterGym[]

  @@index([normalizedName])
  @@index([prefecture, city])
}

model Athlete {
  id            String   @id
  name          String
  nameKana      String
  sport         String
  organizations String[]
  photo         String
  birthdate     String?
  heightCm      Float?
  weightKg      Float?
  reachCm       Float?
  weightClass   String
  nationality   String
  gymId         String?
  gymNote       String?
  // 全体順位の手動調整(小さいほど先に表示)
  displayOrder  Int?
  // 所属団体(表示順の並び替えに使用)。取得元から自動判定、または手動設定
  primaryOrganization String?
  // 活躍度(自動算出): 戦績・注目選手指定等から算出。高いほど上位表示
  prominenceScore Float?
  bio           String?
  nickname      String?
  signatureMove String?
  fightingStyle String?
  stance        String?
  backbone      String?
  sns           Json     @default("[]")
  record        Json?
  recordNote    String?
  sourceUrl     String?
  featured      Boolean  @default(false)
  // 管理者が内容を確認済みの選手はクロールによる自動上書きの対象外にする(戦績・戦績補足は除く)
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // --- 全国フルクロール機能で追加 ---
  normalizedName String?
  ringName       String?
  officialUrl    String?
  active         Boolean  @default(true)

  fighterGyms   FighterGym[]
  fightsAsRed   Fight[] @relation("FightRed")
  fightsAsBlue  Fight[] @relation("FightBlue")
  fightsWon     Fight[] @relation("FightWinner")

  @@index([normalizedName])
}

// ============================================================
// 全国フルクロール機能: 競技マスター (多対多)
// ============================================================
model Discipline {
  id        String   @id
  name      String
  category  String?
  createdAt DateTime @default(now())

  gyms  GymDiscipline[]
  fights Fight[]
}

model GymDiscipline {
  id           String   @id
  gymId        String
  disciplineId String
  sourceId     String?
  createdAt    DateTime @default(now())

  gym        Gym         @relation(fields: [gymId], references: [id], onDelete: Cascade)
  discipline Discipline  @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  source     CrawlerSource? @relation(fields: [sourceId], references: [id])

  @@unique([gymId, disciplineId])
}

// ============================================================
// 全国フルクロール機能: 団体 / 大会 / 試合 / 選手所属ジム
// ============================================================
model Organization {
  id               String   @id
  name             String
  organizationType String?
  country          String?
  officialUrl      String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  events Event[]
}

model Event {
  id             String    @id
  organizationId String?
  name           String
  eventDate      DateTime?
  eventDateRaw   String?
  venue          String?
  prefecture     String?
  city           String?
  address        String?
  officialUrl    String?
  status         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  fights       Fight[]

  @@index([organizationId])
}

model Fight {
  id            String   @id
  eventId       String
  fighterRedId  String?
  fighterBlueId String?
  disciplineId  String?
  weightClass   String?
  boutOrder     Int?
  result        String?
  winnerId      String?
  method        String?
  round         Int?
  time          String?
  status        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fighterRed  Athlete?   @relation("FightRed", fields: [fighterRedId], references: [id])
  fighterBlue Athlete?   @relation("FightBlue", fields: [fighterBlueId], references: [id])
  winner      Athlete?   @relation("FightWinner", fields: [winnerId], references: [id])
  discipline  Discipline? @relation(fields: [disciplineId], references: [id])

  @@index([eventId])
}

model FighterGym {
  id               String    @id
  fighterId        String
  gymId            String
  relationshipType String?
  startedAt        DateTime?
  endedAt          DateTime?
  current          Boolean   @default(true)
  sourceId         String?
  createdAt        DateTime  @default(now())

  fighter Athlete        @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  gym     Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  source  CrawlerSource? @relation(fields: [sourceId], references: [id])

  @@index([fighterId])
  @@index([gymId])
}

model Match {
  id             String   @id
  sport          String
  organization   String
  eventName      String
  eventDate      String
  venue          String
  athleteAId     String
  athleteBId     String
  status         String
  votesA         Int      @default(0)
  votesB         Int      @default(0)
  resultWinnerId String?
  sourceUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DreamMatchCard {
  id         String @id
  sport      String
  organization String
  athleteAId String
  athleteBId String
  votes      Int    @default(0)
}

model TrialApplication {
  id            String   @id
  gymId         String
  name          String
  phone         String?
  email         String?
  preferredDate String?
  message       String?
  status        String   @default("new")
  createdAt     DateTime @default(now())
}

model EditRequest {
  id            String   @id
  targetType    String
  targetId      String
  targetName    String
  content       String
  contactName   String?
  contactEmail  String?
  status        String   @default("new")
  createdAt     DateTime @default(now())
}

// 勝敗予想・次に観たい試合ページのコメント。投稿時に簡易フィルターで
// 不適切な内容を自動判定し、該当すれば非表示(removed/filter)にする。
// 管理者は/admin/commentsから手動でも削除できる(removed/admin)。
model Comment {
  id            String   @id
  targetType    String // "match" | "dreamMatch"
  targetId      String
  authorName    String?
  body          String
  status        String   @default("visible") // "visible" | "removed"
  removedReason String? // "filter" | "admin"
  createdAt     DateTime @default(now())

  @@index([targetType, targetId])
}

model GymListingRequest {
  id                 String   @id
  gymName            String
  sports             String[]
  prefecture         String
  city               String
  address            String?
  phone              String?
  websiteUrl         String?
  description        String?
  instructors        String? // 主な指導者。1行1名の自由記述(承認時に手動でGym.instructorsへ反映)
  belongingAthletes  String? // 所属選手。1行1名の自由記述(承認時に選手ページとの紐付けを手動で行う)
  contactName        String
  contactEmail       String
  status             String   @default("new")
  createdAt          DateTime @default(now())
}

model AthleteListingRequest {
  id           String   @id
  athleteName  String
  sport        String
  gymName      String?
  organization String?
  nationality  String?
  weightClass  String?
  note         String?
  contactName  String
  contactEmail String
  status       String   @default("new")
  createdAt    DateTime @default(now())
}

// ジム・選手ページに掲載されている情報の誤りを報告してもらうためのフォーム(仕様: 掲載依頼とは別導線)。
model CorrectionRequest {
  id           String   @id
  targetType   String // "gym" | "athlete"
  targetId     String
  targetName   String
  details      String
  contactName  String?
  contactEmail String?
  status       String   @default("new")
  createdAt    DateTime @default(now())
}

// ============================================================
// 全国フルクロール機能: クローラー基盤
// ============================================================

model CrawlerSource {
  id             String    @id
  name           String
  baseUrl        String
  entryUrl       String
  category       String?
  disciplineId   String?
  sourceType     String
  isOfficial     Boolean   @default(false)
  trustScore     Int       @default(3)
  enabled        Boolean   @default(true)
  crawlInterval  String?
  rateLimitMs    Int       @default(1500)
  maxConcurrency Int       @default(1)
  parserName     String
  robotsAllowed  Boolean?
  lastCrawledAt  DateTime?
  lastSuccessAt  DateTime?
  lastErrorAt    DateTime?
  status         String    @default("idle")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sourceRuns     CrawlSourceRun[]
  crawlUrls      CrawlUrl[]
  rawRecords     CrawlRawRecord[]
  entitySources  EntitySource[]
  gymDisciplines GymDiscipline[]
  fighterGyms    FighterGym[]
}

model CrawlRun {
  id                  String    @id
  crawlType           String
  status              String    @default("running")
  startedAt           DateTime  @default(now())
  finishedAt          DateTime?
  totalSources        Int       @default(0)
  completedSources    Int       @default(0)
  failedSources       Int       @default(0)
  pagesFetched        Int       @default(0)
  gymsFound           Int       @default(0)
  gymsCreated         Int       @default(0)
  gymsUpdated         Int       @default(0)
  fightersFound       Int       @default(0)
  eventsFound         Int       @default(0)
  fightsFound         Int       @default(0)
  duplicateCandidates Int       @default(0)
  errorsCount         Int       @default(0)
  dryRun              Boolean   @default(false)
  triggeredBy         String?

  sourceRuns CrawlSourceRun[]
  crawlUrls  CrawlUrl[]
  rawRecords CrawlRawRecord[]

  @@index([status])
}

model CrawlSourceRun {
  id           String    @id
  crawlRunId   String
  sourceId     String
  status       String    @default("pending")
  startedAt    DateTime?
  finishedAt   DateTime?
  pagesFetched Int       @default(0)
  recordsFound Int       @default(0)
  createdCount Int       @default(0)
  updatedCount Int       @default(0)
  skippedCount Int       @default(0)
  errorCount   Int       @default(0)
  errorMessage String?

  crawlRun CrawlRun      @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  source   CrawlerSource @relation(fields: [sourceId], references: [id])

  @@unique([crawlRunId, sourceId])
}

model CrawlUrl {
  id            String    @id
  crawlRunId    String
  sourceId      String
  url           String
  canonicalUrl  String
  urlType       String?
  status        String    @default("pending")
  priority      Int       @default(0)
  retryCount    Int       @default(0)
  parentUrl     String?
  discoveredAt  DateTime  @default(now())
  crawledAt     DateTime?

  crawlRun CrawlRun      @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  source   CrawlerSource @relation(fields: [sourceId], references: [id])

  @@unique([crawlRunId, canonicalUrl])
  @@index([status])
}

model CrawlRawRecord {
  id         String   @id
  crawlRunId String
  sourceId   String
  sourceUrl  String
  entityType String?
  rawPayload String   @db.Text
  contentHash String
  fetchedAt  DateTime @default(now())

  crawlRun CrawlRun      @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  source   CrawlerSource @relation(fields: [sourceId], references: [id])

  @@index([contentHash])
}

model EntitySource {
  id               String    @id
  entityType       String
  entityId         String
  fieldName        String
  value            String    @db.Text
  sourceId         String
  sourceUrl        String?
  fetchedAt        DateTime  @default(now())
  verifiedAt       DateTime?
  confidenceScore  Float     @default(0.5)
  current          Boolean   @default(true)

  source CrawlerSource @relation(fields: [sourceId], references: [id])

  @@index([entityType, entityId, fieldName])
}

model DuplicateCandidate {
  id            String    @id
  entityType    String
  entityAId     String
  entityBId     String
  matchStrength String
  matchReasons  String[]
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?
  resolvedBy    String?

  @@unique([entityType, entityAId, entityBId])
  @@index([status])
}
